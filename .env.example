# Copie este arquivo para .env e defina seus proprios valores.
# O .env nao vai para o Git.

# Banco de dados de desenvolvimento (lido pelo docker-compose.yml)
DB_USERNAME=secretaria
DB_PASSWORD=troque-esta-senha
DB_NAME=Secretaria
DB_PORT=1804

# Segredo usado para assinar os tokens JWT.
# Use um valor longo e aleatorio; nunca reaproveite senhas pessoais.
JWT_SECRET=troque-este-segredo

# Observacao: o docker-compose le este arquivo automaticamente.
# A aplicacao Spring le as mesmas variaveis do ambiente, entao exporte-as
# no terminal (ou configure na sua IDE) antes de rodar ./mvnw spring-boot:run.
